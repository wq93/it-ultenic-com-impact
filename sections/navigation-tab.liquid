<navigation-tab class="media-with-text {% if section.settings.spacing == 'none' %}{% if section.settings.full_width %}full-bleed{% else %}rounded{% endif %}{% endif %}">
  <style>
    #shopify-section-{{ section.id }} {
      {% if section.settings.remove_vertical_spacing %}--section-spacing-block: 0px;{% endif %}
      {% if section.settings.remove_horizontal_spacing %}--section-spacing-inline: 0px;{% endif %}
      position: sticky;
      top: calc(var(--header-is-visible, 1) * var(--header-height, 0px));
      z-index: 2;
      display: none;
      transition: top 0.2s ease;
    }
    #shopify-section-{{ section.id }} .section{
      width: 100%;
      overflow: auto;
      padding-top: 12px;
      padding-bottom: 12px;

    }

    #shopify-section-{{ section.id }} ul {
      display: flex;
      gap: 20px;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      margin: 0;
      padding: 0;
      list-style: none;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} ul::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .common-tabbar-item {
      flex: 0 0 auto;
      white-space: nowrap;
      padding: 8px 30px;
      width: fit-content;
      border-radius: 50px;
      flex: none;
      margin: 0;
      border: 0;
      cursor: pointer;
      background: var(--btn-bg, {{ section.settings.button_bg_color }});
      color: var(--btn-text, {{ section.settings.button_text_color }});
    }
    #shopify-section-{{ section.id }} .common-tabbar-item.active {
      background: var(--active-btn-bg, {{ section.settings.active_button_bg_color }});
      color: var(--active-btn-text, {{ section.settings.active_button_text_color }});
    }
  </style>

  <div {% render 'section-properties' %}>
    <ul class="navigation-tab-ul"></ul>
  </div>
  <script>
    if (!customElements.get('navigation-tab')) {
      customElements.define('navigation-tab', class extends HTMLElement {
        connectedCallback() {
          const init = () => {
            if (this.isInitialized) return;

            const headerEle = document.querySelector('.header__wrapper');
            const sectionEle = this.closest('.shopify-section') || document.querySelector('#shopify-section-{{ section.id }}');

            // Cleanup any duplicated section wrappers generated by Theme Editor updates
            const allSections = document.querySelectorAll('#shopify-section-{{ section.id }}');
            if (allSections.length > 1) {
              allSections.forEach(sec => {
                if (sec !== sectionEle) {
                  sec.remove();
                }
              });
            }

            // Force apply styles here so Theme Editor updates immediately
            if (sectionEle) {
              sectionEle.style.backgroundColor = '{{ section.settings.component_bg_color }}';
              sectionEle.style.color = '{{ section.settings.component_text_color }}';
              sectionEle.style.setProperty('--btn-bg', '{{ section.settings.button_bg_color }}');
              sectionEle.style.setProperty('--btn-text', '{{ section.settings.button_text_color }}');
              sectionEle.style.setProperty('--active-btn-bg', '{{ section.settings.active_button_bg_color }}');
              sectionEle.style.setProperty('--active-btn-text', '{{ section.settings.active_button_text_color }}');
            }

            const navigationNames = document.querySelectorAll(
                    'section[id^="shopify-section-template"] [data-navigation-name]'
            );
            const targetEle = this.querySelector('.navigation-tab-ul');

            if (!targetEle) return;

            if (!navigationNames.length) {
              if (sectionEle) sectionEle.style.display = 'none';
              return;
            }

            if(headerEle && sectionEle) {
              sectionEle.style.display = 'block';
            }

            const mainProductSection = document.querySelector('.shopify-section--main-product');
            if (mainProductSection && sectionEle && mainProductSection.nextElementSibling !== sectionEle) {
              mainProductSection.insertAdjacentElement('afterend', sectionEle);
            }

            this.isInitialized = true;
            targetEle.innerHTML = '';

            navigationNames.forEach((navNode, index) => {
              const parentSection = navNode.closest('section[id^="shopify-section-template"]');
              if (!parentSection) return;

              const id = parentSection.id;
              const name = navNode.dataset.navigationName;

              if (!name) return;

              const div = document.createElement('div');
              div.className = `common-tabbar-item${index === 0 ? ' active' : ''}`;
              div.dataset.id = id;
              div.textContent = name;

              targetEle.appendChild(div);
            });

            const newTargetEle = targetEle.cloneNode(true);
            targetEle.parentNode.replaceChild(newTargetEle, targetEle);

            newTargetEle.addEventListener('click', (e) => {
              const item = e.target.closest('.common-tabbar-item');
              if (!item) return;

              if (item.dataset.id) {
                const targetSection = document.getElementById(item.dataset.id);
                if (!targetSection) return;
                item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
              } else if (item.dataset.scrollTarget) {
                const scrollTarget = document.querySelector(item.dataset.scrollTarget);
                if (!scrollTarget) return;
                item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }

              newTargetEle.querySelectorAll('.common-tabbar-item').forEach(i => i.classList.remove('active'));
              item.classList.add('active');
            });

            // Append a tab button for Judge.me reviews if the widget title exists
            const appendJudgemeTab = () => {
              if (newTargetEle.querySelector('[data-scroll-target="#judgeme_product_reviews"]')) return;
              const titleEl = document.querySelector('#judgeme_product_reviews .jdgm-rev-widg__title');
              if (!titleEl) return;
              const reviewBtn = document.createElement('div');
              reviewBtn.className = 'common-tabbar-item';
              reviewBtn.dataset.scrollTarget = '#judgeme_product_reviews';
              reviewBtn.innerHTML = titleEl.innerHTML;
              newTargetEle.appendChild(reviewBtn);
            };

            appendJudgemeTab();

            // Judge.me loads asynchronously — observe DOM for the title element
            if (!document.querySelector('#judgeme_product_reviews .jdgm-rev-widg__title')) {
              const observer = new MutationObserver(() => {
                const titleEl = document.querySelector('#judgeme_product_reviews .jdgm-rev-widg__title');
                if (titleEl) {
                  observer.disconnect();
                  appendJudgemeTab();
                }
              });
              observer.observe(document.body, { childList: true, subtree: true });
            }
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
          } else {
            init();
          }

          if (window.Shopify && Shopify.designMode) {
            if (!this.dataset.boundThemeEditor) {
              this.dataset.boundThemeEditor = 'true';
              document.addEventListener('shopify:section:load', () => {
                this.isInitialized = false;
                init();
              });
            }
          }
        }
      });
    }
  </script>
</navigation-tab>
{% schema %}
{
  "name": "Navigation tab",
  "class": "navigation-tab",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "component_bg_color",
      "label": "Component background color",
      "default": "#253148"
    },
    {
      "type": "color",
      "id": "component_text_color",
      "label": "Component text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#575757"
    },
    {
      "type": "color",
      "id": "active_button_bg_color",
      "label": "Active button background color",
      "default": "#7792ba"
    },
    {
      "type": "color",
      "id": "active_button_text_color",
      "label": "Active button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Navigation tab"
    }
  ]
}
{% endschema %}
