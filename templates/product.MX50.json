        "image_Ep4ycE": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/5-1_6c4fb0c4-61c2-4707-8635-5a1643fb0579.jpg",
            "media_width": 40,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Modalità esperta per tappeti",
            "content": "<p>Grazie alla tecnologia a ultrasuoni, il robot rileva con precisione i tappeti, solleva automaticamente il panno e attiva la modalità di potenza potenziata per una pulizia profonda, proteggendo al contempo i tessuti.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
