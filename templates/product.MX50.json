            "media_width": 40,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Navigazione con IA",
            "content": "<p>Rileva, analizza ed evita gli ostacoli in tempo reale con precisione millimetrica, garantendo una pulizia sicura ed efficace.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
