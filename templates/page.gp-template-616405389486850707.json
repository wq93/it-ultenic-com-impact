    "gp_section_616405389553959571": {
      "type": "gp-section-616405389553959571",
      "settings": {
        "section_preload": "false",
        "checksum": "22d43979edd14e49a46ca2ce187e48aaf8de1a6ab0b7766f7f01e6f086966676_1_1_1_0__1",
        "ggGDtn5znxZ_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/landing_page_background.png",
        "ggBzuy42wmM_text": "<span style=\"color:#E72460;\"><strong>Recensioni di utenti reali</strong></span>",
        "ggXhoWMZ91g_text": "Recensioni di utenti reali",
        "ggnVIF6EhDv_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/U20-1.jpg",
        "ggnVIF6EhDv_alt": "Alt Image",
        "ggnVIF6EhDv_title": "Image Title",
        "ggvsT62uPoG_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/U20-2.jpg",
        "ggvsT62uPoG_alt": "Alt Image",
        "ggvsT62uPoG_title": "Image Title",
        "ggc9nsMGf3R_text": "<p><span style=\"font-size:21px;\"><strong>Ultenic U20 Aspirapolvere Senza Fili</strong></span></p>",
        "ggOCLLt7SZa_text": "<p><span style=\"color:rgb(15,17,17);font-size:16px;\">Jacqueline</span></p>",
        "ggbY2PK5grp_text": "<p><strong>Maneggevole​</strong></p>",
        "ggPrHmX-5mz_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);font-size:15px;\">Sono molto soddisfatto del mio acquisto. Questo aspirapolvere offre 3 modalità di funzionamento, inclusa una funzione Boost, e mantiene molto bene la carica. L'indicatore LED verde segnala se sul pavimento è rimasta della polvere. È particolarmente maneggevole grazie al suo braccio telescopico: l'apparecchio può essere utilizzato anche come aspirapolvere portatile.</span></p>",
        "ggLlhao5caG_label": "<p><span style=\"font-size:20px;\"><strong>Scopri di più</strong></span></p>",
        "ggM2nubQANV_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/U18-1.jpg",
        "ggM2nubQANV_alt": "Alt Image",
        "ggM2nubQANV_title": "Image Title",
        "ggsF3dOfzzB_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/U18-3.jpg",
        "ggsF3dOfzzB_alt": "Alt Image",
        "ggsF3dOfzzB_title": "Image Title",
        "gg4iAFhtlSe_text": "<p><span style=\"font-size:21px;\"><strong>Ultenic U18 PowerPro Aspirapolvere Senza Fili</strong></span></p>",
        "ggP7X9N74hc_text": "<p>Paul</p>",
        "ggYOhZickil_text": "<p><strong>Molto bello</strong></p>",
        "gggTnSoyfpK_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(15,17,17);font-size:14px;\">No me esperaba una calidad de fabricación así. Estoy realmente impresionado. El aspirador es potente, tiene un diseño atractivo y parece fácil de mantener. Lo uso en modo medio, y es más que suficiente para baldosas y alfombras. En cuanto a la autonomía, diría que ronda los 40 minutos a potencia media. Solo espero que la batería y el sistema de articulaciones del tubo de aspiración duren mucho tiempo.</span></p>",
        "ggAvNtr7g0O_label": "<p><span style=\"font-size:20px;\"><strong>Scopri di più</strong></span></p>",
        "gghR056FofV_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/T20-2.jpg",
        "gghR056FofV_alt": "Alt Image",
        "gghR056FofV_title": "Image Title",
        "ggcp2sObw0N_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/T20P-1.jpg",
        "ggcp2sObw0N_alt": "Alt Image",
        "ggcp2sObw0N_title": "Image Title",
        "ggIIuAy5FhZ_text": "<p><span style=\"font-size:21px;\"><strong>Ultenic T20 Pro Robot Aspirapolvere Lavapavimenti</strong></span></p>",
        "ggt6x0vJEuW_text": "<p>Anthony LE GOURRIEREC</p>",
        "ggTqiohlijY_text": "<p><span style=\"color:rgb(15,17,17);font-size:21px;\"><strong>Un ottimo prodotto</strong></span></p>",
        "ggemqd97S2O_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);font-size:14px;\">Questo robot aspirapolvere funziona alla perfezione. È piuttosto semplice da configurare: una volta scaricata l'app, è possibile controllarlo anche a distanza. Si svuota automaticamente, è dotato di localizzazione GPS e rileva gli ostacoli lungo il percorso. Lava e aspira contemporaneamente. Una volta programmato, funziona in modo completamente autonomo. Fantastico.</span></p>",
        "ggPt736sf8I_label": "<p><span style=\"font-size:20px;\"><strong>Scopri di più</strong></span></p>",
        "ggzcTTUqQt5_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/AC1_41edff71-fc59-4d2f-96d8-baae72081d04.jpg",
        "ggzcTTUqQt5_alt": "Alt Image",
        "ggzcTTUqQt5_title": "Image Title",
        "ggSslbERcUq_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/AC1-1.jpg",
        "ggSslbERcUq_alt": "Alt Image",
        "ggSslbERcUq_title": "Image Title",
        "gg0DsVono_z_text": "<p><span style=\"font-size:21px;\"><strong>AC1 Elite lavapavimenti Senza Fili</strong></span></p>",
        "ggoTN-qk5-x_text": "<p>Lo consiglio vivamente</p>",
        "gggROLFFIJB_text": "<p>Robot aspirapolvere e lavapavimenti molto potente. È perfetto per le mie piastrelle e rimuove anche le macchie più ostinate. Sono disponibili <br>numerose funzioni, tra cui la pulizia automatica del panno. Ne sono davvero entusiasta. Lo consiglio vivamente.</p>",
        "gg-B-obyLOh_label": "<p><span style=\"font-size:20px;\"><strong>Scopri di più</strong></span></p>",
        "ggQS4ZmG95y_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/subscribe_PC2.png",
        "ggQS4ZmG95y_background_mobile_image_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/subscribe_M2.png",
        "ggUQ4nk1w-s_successMessage": "Merci pour votre abonnement.",
        "ggUQ4nk1w-s_errorMessage": "Impossible d'envoyer l'e-mail. Veuillez réessayer plus tard.",
        "ggAJWHerBvO_placeholder": "Email",
        "ggykRrrvlJ1_label": "Invia",
        "ggdC-iireHh_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/Policy_PC.png",
        "ggdC-iireHh_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0526/2996/2938/files/Policy_M.png"
      }
    },
